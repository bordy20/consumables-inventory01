# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Required for AI scan + chat
ANTHROPIC_API_KEY=

# Strongly recommended: a shared passphrase the app asks for once per device.
# Without it, anyone who finds your URL can use your Anthropic credits.
APP_ACCESS_CODE=

# Optional: override the model (default claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=

# Storage (Upstash Redis / Vercel KV) — added automatically when you connect
# the storage integration to the project:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
